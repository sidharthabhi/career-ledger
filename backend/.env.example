# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_ledger

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=replace-with-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
DEBUG=true
UPLOAD_DIR=uploads
